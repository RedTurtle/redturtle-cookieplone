name: Release latest version on PyPI

on:
  push:
    tags:
      - "*"
  # Permette di ripubblicare un tag senza rifare la release: zest.releaser crea
  # il tag ma non pubblica piu' (`release = false` in [tool.zest-releaser]),
  # quindi se questo workflow fallisce la release e' gia' fatta e va solo
  # ripetuta la publish.
  workflow_dispatch:
    inputs:
      ref:
        description: "Tag da pubblicare"
        required: true

jobs:
  # Lint e test prima di pubblicare. La CI non basta: i workflow non si
  # aspettano fra loro, partono tutti insieme al push del tag. Sono le stesse
  # workflow riusabili di main.yml, cosi' i controlli non divergono.
  #
  # Nota per il workflow_dispatch: un workflow riusabile gira sempre al commit
  # di chi lo chiama, quindi i check guardano il ref da cui lanci il workflow,
  # non l'input `ref` che finisce solo nella checkout della publish.
  config:
    uses: ./.github/workflows/config.yml

  lint:
    name: "Backend: Lint"
    needs:
      - config
    uses: plone/meta/.github/workflows/backend-lint.yml@2.x
    with:
      python-version: ${{ needs.config.outputs.python-version }}
      plone-version: ${{ needs.config.outputs.plone-version }}

  test:
    name: "Backend: Test"
    needs:
      - config
    uses: plone/meta/.github/workflows/backend-pytest.yml@2.x
    with:
      python-version: ${{ needs.config.outputs.python-version }}
      plone-version: ${{ needs.config.outputs.plone-version }}

  release_to_pypi:
    name: Release to PyPI
    runs-on: ubuntu-latest
    needs:
      - lint
      - test
    permissions:
      contents: read
      # il token OIDC con cui PyPI riconosce questo workflow come trusted
      # publisher: e' cio' che sostituisce le credenziali di twine
      id-token: write
    steps:
      - uses: actions/checkout@v6
        with:
          ref: ${{ inputs.ref || github.ref }}

      - uses: astral-sh/setup-uv@v6
        with:
          enable-cache: false

      - name: Build
        run: uv build

      - name: Release to PyPI
        # `always` invece del default `automatic`: senza OIDC il job deve
        # fallire a voce alta, non ripiegare in silenzio su credenziali assenti
        run: uv publish --trusted-publishing always
