name: Release latest version on npm

on:
  push:
    tags:
      - "*"
  # Permette di ripubblicare un tag senza rifare la release: il backend viene
  # gia' pubblicato da scripts/release.sh, quindi se la publish npm fallisce
  # non si puo' semplicemente rilanciare `make release`.
  workflow_dispatch:
    inputs:
      ref:
        description: "Tag da pubblicare"
        required: true

jobs:
  # Lint e test prima di pubblicare. Non basta la CI: i workflow non si
  # aspettano fra loro, partono tutti insieme al push del tag, e per giunta
  # quella sul tag salta ogni job perche' decide dai path modificati, che in un
  # tag sono zero. Qui sono gli stessi controlli, richiamati dallo stesso
  # workflow riusabile, cosi' non divergono.
  #
  # Nota per il workflow_dispatch: un workflow riusabile gira sempre al commit
  # di chi lo chiama, quindi i check guardano il ref da cui lanci il workflow,
  # non l'input `ref` che finisce solo nella checkout della publish.
  config:
    uses: ./.github/workflows/config.yml

  checks:
    name: "Checks"
    uses: ./.github/workflows/frontend.yml
    needs:
      - config
    with:
      base-tag: ${{ needs.config.outputs.base-tag }}
      image-name-prefix: ${{ needs.config.outputs.image-name-prefix }}
      image-name-suffix: frontend
      node-version: ${{ needs.config.outputs.node-version }}
      volto-version: ${{ needs.config.outputs.volto-version }}

  release_to_npm:
    name: Release to npm
    runs-on: ubuntu-latest
    needs:
      - checks
    permissions:
      contents: read
      id-token: write
    defaults:
      run:
        working-directory: @FRONTEND_ROOT@
    steps:
      - uses: actions/checkout@v6
        with:
          ref: ${{ inputs.ref || github.ref }}

      - name: Disable Corepack's packageManager pin
        run: corepack disable

      - uses: pnpm/action-setup@v4
        with:
          version: 11

      - uses: actions/setup-node@v6
        with:
          node-version: '24'
          registry-url: 'https://registry.npmjs.org'
          cache: 'pnpm'
          cache-dependency-path: @FRONTEND_ROOT@/pnpm-lock.yaml

      - run: pnpm install --frozen-lockfile

      - name: Determine npm dist-tag from version
        id: npm-tag
        working-directory: @PACKAGE_PATH@
        run: |
          VERSION=$(node -p "require('./package.json').version")
          if [[ "$VERSION" =~ -([a-zA-Z]+) ]]; then
            TAG="${BASH_REMATCH[1]}"
          else
            TAG="latest"
          fi
          echo "Version $VERSION -> dist-tag $TAG"
          echo "tag=$TAG" >> "$GITHUB_OUTPUT"

      - name: Release to npm
        working-directory: @PACKAGE_PATH@
        run: pnpm publish --provenance --access public --no-git-checks --tag "${{ steps.npm-tag.outputs.tag }}"

      - name: Dump npm debug log on failure
        if: failure()
        run: cat /home/runner/.npm/_logs/*.log
